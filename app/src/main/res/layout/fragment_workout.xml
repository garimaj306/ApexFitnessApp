<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Map View for Live GPS Route Tracking -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 1. PRE-WORKOUT OVERLAY -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_pre_workout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Activity Mode Selector Header -->
        <LinearLayout
            android:id="@+id/header_activity_selector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_hud_overlay"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select Activity"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- GPS Signal Status Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_pill_button"
                        android:backgroundTint="@color/google_fit_green" />

                    <TextView
                        android:id="@+id/tv_gps_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="GPS Ready"
                        android:textColor="@color/google_fit_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Activity Chips (Run, Walk, Cycle, Hike) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_activities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_run"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🏃 Run"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_card" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_walk"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶 Walk"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_card" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cycle"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚴 Cycle"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_card" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hike"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥾 Hike"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/bg_card" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Large Start CTA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_workout"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="24dp"
            android:background="@drawable/bg_pill_button"
            android:elevation="6dp"
            android:fontFamily="sans-serif-black"
            android:text="START WORKOUT"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            app:backgroundTint="@color/strava_orange"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="24dp"
            app:iconTint="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. ACTIVE WORKOUT HIGH-CONTRAST OUTDOOR HUD -->
    <LinearLayout
        android:id="@+id/layout_active_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud_overlay"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <!-- Top Status Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hud_activity_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACTIVE RUN"
                android:textColor="@color/strava_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Live Heart Rate Pulse -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_heart_rate" />

                <TextView
                    android:id="@+id/tv_hud_heart_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="148 BPM"
                    android:textColor="@color/heart_rate_red"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Metric Grid Row 1: Time & Distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Fitness.HUD.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME" />

                <TextView
                    android:id="@+id/tv_hud_time"
                    style="@style/TextAppearance.Fitness.HUD.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Fitness.HUD.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE (KM)" />

                <TextView
                    android:id="@+id/tv_hud_distance"
                    style="@style/TextAppearance.Fitness.HUD.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00" />
            </LinearLayout>
        </LinearLayout>

        <!-- Metric Grid Row 2: Pace & Calories -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Fitness.HUD.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT PACE" />

                <TextView
                    android:id="@+id/tv_hud_pace"
                    style="@style/TextAppearance.Fitness.HUD.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--&apos;--&quot;"
                    android:textColor="@color/google_fit_cyan" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Fitness.HUD.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CALORIES" />

                <TextView
                    android:id="@+id/tv_hud_calories"
                    style="@style/TextAppearance.Fitness.HUD.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kcal"
                    android:textColor="@color/google_fit_green" />
            </LinearLayout>
        </LinearLayout>

        <!-- Workout Control Buttons (Pause / Resume / Finish) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_resume"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_card_elevated"
                android:text="PAUSE"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_pause"
                app:iconGravity="textStart"
                app:strokeColor="@color/bg_stroke"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish_workout"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/heart_rate_red"
                android:text="FINISH"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_stop"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
