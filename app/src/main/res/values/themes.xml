<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FitnessApp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/strava_orange</item>
        <item name="colorPrimaryContainer">@color/bg_card_elevated</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <!-- Secondary Accents -->
        <item name="colorSecondary">@color/google_fit_cyan</item>
        <item name="colorSecondaryContainer">@color/bg_surface</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <item name="colorTertiary">@color/google_fit_green</item>
        <item name="colorOnTertiary">@color/bg_dark</item>

        <!-- Background & Surfaces -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status & Navigation Bar Styling -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Custom Card Style -->
    <style name="FitnessCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/bg_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Active High-Contrast Metric Typography -->
    <style name="TextAppearance.Fitness.HUD.Value" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextAppearance.Fitness.HUD.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>
</resources>
